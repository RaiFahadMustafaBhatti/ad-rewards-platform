# Server — copy to .env (never commit the real values)
#
# Firebase Admin SDK service account (Project settings > Service accounts >
# Generate new private key). YOU download this yourself from the Firebase
# console and paste the three values into your host's secret store
# (e.g. Vercel environment variables). Never paste the private key into chat.
FIREBASE_PROJECT_ID=fmb-earning-hub
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fmb-earning-hub.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# First-party session signing secret (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Local administrator login (independent of Firebase member login)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Backblaze B2 private file storage (free tier: 10 GB storage, 1 GB/day egress)
# Create a private bucket + application key at b2.backblaze.com.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Client — prefix with VITE_ so Vite exposes them to the browser bundle.
# These are the PUBLIC Firebase web config values (safe to expose).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fmb-earning-hub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fmb-earning-hub
VITE_FIREBASE_STORAGE_BUCKET=fmb-earning-hub.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
